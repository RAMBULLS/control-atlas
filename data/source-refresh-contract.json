  "conditional_request_contract": {
    "implementation": "scripts/lib/strict-conditional-fetch.mjs",
    "etag": true,
    "last_modified": true,
    "success_304": "return validated cached publisher bytes with x-local-cache-status=revalidated",
    "stale_fallback": "reject",
    "missing_validators": "perform a fresh request",
    "unchanged_outputs": "compare bytes before atomic replacement"
  },
