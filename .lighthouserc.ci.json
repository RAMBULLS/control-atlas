{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npm run serve:static",
      "startServerReadyPattern": "Control Atlas static site available",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://localhost:4317/",
        "http://localhost:4317/#/resources",
        "http://localhost:4317/#/record/nist-800-53/AC-2"
      ],
      "settings": {
        "saveAssets": true,
        "chromeFlags": "--headless --no-sandbox",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1800000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 400000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lighthouse-ci"
    }
  }
}
