  "behavior": {
    "check_tiers": {
      "conditional_get": "Conditional GET (ETag / Last-Modified). An unchanged publisher answers 304 and no bytes are downloaded.",
      "range_probe": "Ranged download with byte-length and total checks; the publisher does not offer validators for its large archive.",
      "per_item_conditional_get": "One conditional GET per registered item; each unchanged item is a 304."
    },
    "transient_failure": {
      "scope": "timeout, dropped connection, DNS failure, HTTP 408/425/429/500/502/503/504",
      "request_retry": {
        "attempts": 3,
        "base_ms": 1000,
        "max_ms": 8000,
        "retry_after_cap_ms": 15000,
        "timeout_ms": 60000
      },
      "source_retry": {
        "retry_only": "transient",
        "base_ms": 15000,
        "max_ms": 60000,
        "attempts": "ingestion task retries"
      },
      "never_retried": "HTTP 404/403, validation rejections, parse errors and policy violations",
      "mirrors": "forbidden; only registered official hosts are contacted (data/source-url-policy.json)",
      "on_exhaustion": "restore the last accepted files, record the source as quarantined, update one health issue"
    },
    "last_known_good": "Each source runs in a transaction over its declared output paths. Any failure before acceptance restores the prior bytes. Only refresh:data finalization advances the accepted baseline, and only after every gate has passed.",
    "quarantine": "A rejected candidate quarantines only its own source. Other sources continue and publish.",
    "large_change_policy": "A count change outside the band is accepted only with identity and inventory evidence: the publisher revision proves itself, or the publisher inventory reconciles exactly and few prior identities were removed. Otherwise it is quarantined with the added, removed and changed counts.",
    "change_evidence": "data/source-change-log.json records previous and current accepted identity, counts, lifecycle transitions and accepted time for every accepted change.",
    "outcome": "tools/classify-refresh-outcome.mjs stops the run before build, browser install, verification, pull request and deploy when only dates and run timings moved.",
    "freshness_heartbeat_days": 21
  }
}
